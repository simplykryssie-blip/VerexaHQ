# Point local development at the isolated staging project
# (uzdlqioslnqqikiouksg / verexahq-test), never at production -- local runs
# have no VERCEL_ENV set, so lib/env.ts treats them as "development" and
# lib/providerStatus.ts already blocks live email/SMS/Stripe sends here
# regardless, but using the staging database too keeps local writes (test
# clients, engagements, etc.) out of real firm/client data entirely.
NEXT_PUBLIC_SUPABASE_URL=https://uzdlqioslnqqikiouksg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Server-only. Required for the Stripe/Resend/Twilio webhook routes and the
# notification dispatcher cron route (they use the service-role key, not
# the cookie-based session, since they run unauthenticated/privileged).
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret for the Connect-scoped webhook endpoint
# (/api/stripe/webhook/connect) -- configure this endpoint in Stripe with
# "Listen to events on connected accounts" enabled, separate from the
# platform endpoint above.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Stripe Connect OAuth client ID (Stripe Dashboard > Connect > Settings >
# OAuth settings). Lets a workspace link or create its OWN Stripe account
# via "Connect with Stripe" so ITS clients pay invoices directly to that
# workspace -- separate from STRIPE_SECRET_KEY above, which is Verexa's own
# platform account that charges workspaces for their subscription.
STRIPE_CONNECT_CLIENT_ID=

# Email provider (Resend). Once RESEND_API_KEY is set, /api/email/send goes
# live -- until then it's a no-op and callers get { sent: false } back.
# EMAIL_FROM_ADDRESS overrides every system sender identity with a single
# address; leave it blank to use the per-purpose verexahq.com identities
# defined in lib/email/resend.ts (noreply/support/billing/notifications/team)
# once that domain is verified in Resend.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=VerexaHQ

# Optional SMS provider (Twilio). Same no-op-until-configured behavior via
# /api/sms/send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Zoom (User-managed OAuth app -- each staff member connects their own
# personal Zoom account). ZOOM_WEBHOOK_SECRET_TOKEN is the app's "Secret
# Token" used for both the endpoint URL validation handshake and verifying
# delivered events (currently just app deauthorization) at /api/zoom/webhook.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# Google Calendar (user-managed OAuth app -- each staff member connects
# their own personal Google account, same pattern as Zoom). Create an OAuth
# client in Google Cloud Console (APIs & Services > Credentials > OAuth
# client ID > Web application), enable the Google Calendar API on that
# project, and add this exact redirect URI:
#   https://<your-app-domain>/api/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Outlook / Microsoft 365 Calendar (user-managed OAuth app). Register an app
# in the Azure Portal (Microsoft Entra ID > App registrations > New
# registration, "Accounts in any organizational directory and personal
# Microsoft accounts"), add a client secret under Certificates & secrets,
# grant the Calendars.ReadWrite and User.Read Microsoft Graph delegated
# permissions, and add this exact redirect URI:
#   https://<your-app-domain>/api/calendar/microsoft/callback
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Shared secret the notification dispatcher cron route
# (/api/cron/dispatch-notifications) checks against an
# "Authorization: Bearer <value>" header -- Vercel Cron sends this
# automatically when set as a project environment variable.
CRON_SECRET=

# Public app URL used in emails, invitation/portal links, and Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Outside Production (local dev, and every Vercel Preview deployment --
# see lib/env.ts), isEmailConfigured/isSmsConfigured/isStripeConfigured in
# lib/providerStatus.ts always report "not configured" no matter what's set
# above, so RESEND_API_KEY/TWILIO_*/STRIPE_SECRET_KEY never actually reach a
# live provider from a non-Production environment -- this also covers
# signature-request notifications, since those go out through the same
# email path. Set this to deliberately test a real send (e.g. against your
# own inbox/phone) from a non-Production environment; leave it unset otherwise.
ALLOW_LIVE_SENDS_OUTSIDE_PRODUCTION=

# Vercel API token (team-scoped, from vercel.com/account/tokens) that lets a
# workspace's "Connect domain" button in Website Settings attach the domain
# to this Vercel project automatically, instead of requiring a manual
# Project > Settings > Domains > Add step. The team/project ids themselves
# are hardcoded in lib/vercel/domains.ts (not secrets). Without this set,
# the domain manager still works -- it just falls back to a plain DNS check
# and tells the workspace to add the domain in Vercel manually.
VERCEL_API_TOKEN=
